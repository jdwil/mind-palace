# Mind Palace Remote MCP Server
#
# Streamable HTTP MCP server for remote agent harnesses.
# Deploy to ECS/EC2 (behind a VPN or with MP_AUTH_TOKEN set).

FROM rust:1.96-slim AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cargo build --release --bin mind-palace-mcp-remote

FROM rust:1.96-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/mind-palace-mcp-remote /usr/local/bin/mind-palace-mcp-remote

# Streamable HTTP listens here by default (override with MP_BIND_ADDR).
EXPOSE 8080

ENTRYPOINT ["mind-palace-mcp-remote"]
